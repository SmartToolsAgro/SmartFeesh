{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(\"/c/Program Files/GitHub CLI/gh.exe\" pr merge *)",
      "Bash(\"C:\\Program Files\\GitHub CLI\\gh.exe\" pr merge *)",
      "Bash(\"/c/Program Files/GitHub CLI/gh.exe\" pr merge:*)",
      "Bash(git add .claude/settings.json)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
